# Server Configuration
PORT=4000
HOST=localhost

# TradingView Configuration
POLL_INTERVAL=1000
PAGE_LOAD_TIMEOUT=30000
DEFAULT_EXCHANGE=BINANCE
TRADINGVIEW_BASE_URL=https://www.tradingview.com/symbols

# Price Validation
MIN_PRICE_RANGE=0.01
MAX_PRICE_RANGE=1000000

# LLM Provider Configuration
# Supported: "ollama", "nvidia", or "azure"
LLM_PROVIDER=ollama

# Ollama Configuration (default)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# NVIDIA API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2

# Azure OpenAI Configuration
AZURE_ENDPOINT=https://your-resource.openai.azure.com
AZURE_API_KEY=your_azure_api_key_here
AZURE_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_NAME=your-deployment-name

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Agent Configuration
MARATHON_TASK_MAX_DURATION_HOURS=24
CHECKPOINT_INTERVAL_MINUTES=15
MAX_SELF_CORRECTION_ATTEMPTS=3
